# Copy to .env and fill in. The .env file is gitignored.

# --- LLM providers ---
# The agent under evolution and both judges run on OpenAI.
OPENAI_API_KEY=your_openai_api_key_here
# The mutation model runs on Google (Gemini).
GEMINI_API_KEY=your_gemini_api_key_here
# Only needed to reproduce the Claude Code baseline.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Evolution run configuration (all optional; defaults live in moevo/evolve/config.py) ---
# Agent under evolution, and the GDPval/ToolEmu judge.
EVOLVE_AGENT_MODEL=gpt-5.4
EVOLVE_JUDGE_MODEL=gpt-5.4
# Which cascade slice to evolve on: S1..S8 for development, E1/E2 are held out.
EVOLVE_SLICE=S1
# Tasks drawn per evaluation, per benchmark.
EVOLVE_SAMPLE_SIZE=11
EVOLVE_SAFETY_SAMPLES=11
# Scalarization weight. Used only by the SkyDiscover ablation; MOEvo ignores it.
EVOLVE_SAFETY_WEIGHT=0.5
# Scratch directory for candidate programs. Must be writable.
EVOLVE_WORKING_DIR=./workspace
